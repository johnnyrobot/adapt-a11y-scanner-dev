# ============================================================================
# adapt-a11y-scanner configuration
# Copy to .env and fill in. Nothing is hardcoded.
# ============================================================================

# --- ADAPT instance ---------------------------------------------------------
# Must be https in production; only localhost/127.0.0.1 may use http for dev.
ADAPT_BASE_URL=https://adapt.libretexts.org

# Auth: PREFERRED — a pre-issued JWT for a service account (from your secrets
# manager). The bridge sets it as ADAPT's `token` cookie (httpOnly, secure).
ADAPT_TOKEN=

# Auth fallback (dev/bootstrap only): the bridge will POST /api/login to mint a
# token. Do NOT use a human password in production — issue a service token.
# ADAPT_EMAIL=
# ADAPT_PASSWORD=

# --- Rendering --------------------------------------------------------------
# iframe = render /api/get-header-html/{id} directly (fast, deterministic).
# spa    = render the full SPA question-view (needs an assignmentId; closer to
#          the student-facing view).
RENDER_MODE=iframe
MATHJAX_TIMEOUT_MS=20000
NAV_TIMEOUT_MS=30000

# Launch Chromium with --no-sandbox. Leave off (sandbox ON) — the container runs
# as the non-root pwuser. Set to 1 only when running as root where the sandbox
# is impossible. (NOT recommended.)
# CHROMIUM_NO_SANDBOX=

# --- Scanning ---------------------------------------------------------------
# http       = POST rendered DOM to a running remedy-server (decoupled). Production.
# in-process = scan with the bundled @libretexts/remedy-core (DEV-ONLY; must be
#              installed/linked — see README. Not wired for production transfer).
SCAN_MODE=http

# Required when SCAN_MODE=http:
REMEDY_ENDPOINT=https://remedy.libretexts.org/v1/validate/html
# Required when SCAN_MODE=http: the remedy-server API key, sent as the X-API-Key
# header. Must equal the server's APP_API_KEY. (The server ignores Authorization.)
REMEDY_API_KEY=
# Max ms to wait for the synchronous remedy-server scan (default 240000).
REMEDY_TIMEOUT_MS=240000

# --- HTTP job lifecycle -----------------------------------------------------
# Per-process finite positive integer limits; assignment questions are sequential.
SCANNER_MAX_ACTIVE_JOBS=1
SCANNER_MAX_QUEUED_JOBS=8
# Absolute total deadline including queue/auth/render/validation/retry wait.
SCANNER_JOB_TIMEOUT_MS=900000
# HTTP mode is required for the server; in-process remains dev CLI-only.
# Cleanup grace is 5 seconds; total shutdown <=15 seconds. Stack stop grace must
# exceed 15 seconds; proxy/client timeouts must exceed total deadline + cleanup.
