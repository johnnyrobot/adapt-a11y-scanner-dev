# ============================================================================
# adapt-a11y-scanner configuration
# Copy to .env and fill in. Nothing is hardcoded.
# ============================================================================

# --- ADAPT instance ---------------------------------------------------------
ADAPT_BASE_URL=https://adapt.libretexts.org

# Auth: PREFERRED — a pre-issued JWT for a service account (from your secrets
# manager). The bridge sets it as ADAPT's `token` cookie.
ADAPT_TOKEN=

# Auth fallback (dev/bootstrap only): the bridge will POST /api/login to mint a
# token. Do NOT use a human password in production — issue a service token.
# ADAPT_EMAIL=
# ADAPT_PASSWORD=

# --- Rendering --------------------------------------------------------------
# iframe = render /api/get-header-html/{id} directly (fast, deterministic).
# spa    = render the full SPA question-view (needs an assignmentId; closer to
#          the student-facing view).
RENDER_MODE=iframe
MATHJAX_TIMEOUT_MS=20000
NAV_TIMEOUT_MS=30000

# --- Scanning ---------------------------------------------------------------
# http       = POST rendered DOM to a running remedy-server (decoupled).
# in-process = scan with the bundled @libretexts/remedy-core (must be installed).
SCAN_MODE=http

# Required when SCAN_MODE=http:
REMEDY_ENDPOINT=http://remedy-server:8000/v1/validate/html
# Optional bearer token for the remedy endpoint:
# REMEDY_TOKEN=
